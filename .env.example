# PRESENTATION FRONTEND (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anonymous-key
# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Where apps/web reaches the orchestra swarm service (local dev vs deployed)
ORCHESTRA_SERVICE_URL=http://localhost:8000

# ORCHESTRATION BACKEND (Python FastAPI / LangGraph)
DATABASE_URL=postgresql://postgres:password@your-supabase-db.supabase.co:5432/postgres
LOCAL_WASM_SANDBOX_ENABLED=true
ADMIN_DAILY_OUTREACH_CEILING=10
ORCHESTRA_MODEL=gpt-4o-mini
ORCHESTRA_ALLOWED_ORIGIN=http://localhost:3000

# BASELINE COMPUTE (Local fallback or serverless routing setup)
OPENAI_API_KEY=optional_if_running_local_ollama_endpoints
GEMINI_API_KEY=your_gemini_flash_key_for_low_cost_turns
